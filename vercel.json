{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/dwellings", "destination": "/api/structure?resource=dwellings" },
    { "source": "/api/families/:id", "destination": "/api/structure?resource=family&id=:id" },
    { "source": "/api/fund-rate", "destination": "/api/fund?action=rate" },
    { "source": "/api/fund-data", "destination": "/api/fund?action=data" },
    { "source": "/api/fund-contribute", "destination": "/api/fund?action=contribute" },
    { "source": "/api/scan-cedula", "destination": "/api/scan?type=cedula" },
    { "source": "/api/scan-rif", "destination": "/api/scan?type=rif" },
    { "source": "/api/cne/lookup", "destination": "/api/cne?resource=lookup" },
    { "source": "/api/cne/bulk-missing", "destination": "/api/cne?resource=bulk-missing" },
    { "source": "/api/cne/sync-children", "destination": "/api/cne?resource=sync-children" },
    { "source": "/api/admin/dwellings/:id/merge", "destination": "/api/admin?resource=dwellings-merge&id=:id" },
    { "source": "/api/admin/families/:id/split", "destination": "/api/admin?resource=families-split&id=:id" },
    { "source": "/api/admin/link-requests", "destination": "/api/admin?resource=link-requests" },
    { "source": "/api/signup", "destination": "/api/auth?action=signup" },
    { "source": "/api/delete-account", "destination": "/api/auth?action=delete-account" },
    { "source": "/api/check-cedula-match", "destination": "/api/register?action=check-match" },
    { "source": "/api/confirm-household-match", "destination": "/api/register?action=confirm-match" },
    { "source": "/api/add-family-member", "destination": "/api/register?action=add-member" },
    { "source": "/api/census-lookup", "destination": "/api/register?action=census-lookup" },
    { "source": "/api/register/census-lookup", "destination": "/api/register?action=census-lookup" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), geolocation=(), microphone=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https: wss:; worker-src 'self' blob:; manifest-src 'self'" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}
